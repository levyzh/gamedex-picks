# Copy this file to ".env" and fill in the real values.
# ".env" is gitignored and must NEVER be committed.

# Your RAWG API key. This is the whole reason this service exists server-side:
# in the main Gamedex app this key ships to the browser, here it does not.
RAWG_KEY=

# Where the Gamedex Spring API lives. Not deployed yet, so local for now.
GAMEDEX_API_BASE=http://localhost:8080

# Supabase's public signing keys. Copied verbatim from the Java API's
# application.properties so both services trust the exact same authority.
SUPABASE_JWKS_URL=https://iorgldbdbekwtrclbynu.supabase.co/auth/v1/.well-known/jwks.json